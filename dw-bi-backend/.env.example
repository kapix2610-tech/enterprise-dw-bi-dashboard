NODE_ENV=development
PORT=5000
JWT_SECRET=replace-this-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
MONGODB_RETRY_MS=15000
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/datawise?retryWrites=true&w=majority
MONGODB_DB=datawise
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24

# Required to deliver account confirmation emails (use a provider SMTP credential).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Datawise <no-reply@example.com>

# Optional AI provider credentials. Leave blank to use local summaries only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
META_API_KEY=
META_MODEL=Llama-4-Scout-17B-16E-Instruct
META_BASE_URL=https://api.llama.com/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
